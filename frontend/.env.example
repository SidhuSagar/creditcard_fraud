# Copy this file to `.env` and edit it if your backend does not run on port 8000.
# The Vite dev server proxies every /api request to this URL.
#
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (macOS / Linux)
#
# Default: the standard FastAPI/uvicorn port.
VITE_BACKEND_URL=http://127.0.0.1:8000
